{
  "_about": "Link test cases shared by the Rust parser (src-tauri/src/wikilinks.rs) and the TypeScript renderer (src/markdown.ts), so the two can't disagree. `links`: every [[link]] found in `input`, in order, with the page part, the section part (null = none) and the text shown on the page. `anchors`: the section anchor of every heading in `input`, in order.",
  "links": [
    { "name": "plain", "input": "See [[Page A]] here.", "links": [{ "page": "Page A", "section": null, "text": "Page A" }] },
    { "name": "shown text", "input": "[[Page A|the first page]]", "links": [{ "page": "Page A", "section": null, "text": "the first page" }] },
    { "name": "section", "input": "[[Page A#Early life]]", "links": [{ "page": "Page A", "section": "Early life", "text": "Page A § Early life" }] },
    { "name": "section with shown text", "input": "[[Page A#Early life|childhood]]", "links": [{ "page": "Page A", "section": "Early life", "text": "childhood" }] },
    { "name": "same page section", "input": "Back to [[#Notes]].", "links": [{ "page": "", "section": "Notes", "text": "§ Notes" }] },
    { "name": "pipe trick", "input": "[[Page A (Example)|]]", "links": [{ "page": "Page A (Example)", "section": null, "text": "Page A" }] },
    { "name": "pipe trick without brackets", "input": "[[Page A|]]", "links": [{ "page": "Page A", "section": null, "text": "Page A" }] },
    { "name": "word ending", "input": "Two [[Page]]s and [[Item|thing]]es.", "links": [{ "page": "Page", "section": null, "text": "Pages" }, { "page": "Item", "section": null, "text": "thinges" }] },
    { "name": "word ending stops at punctuation", "input": "[[Page]]'s end", "links": [{ "page": "Page", "section": null, "text": "Page" }] },
    { "name": "accented word ending", "input": "[[Page]]én", "links": [{ "page": "Page", "section": null, "text": "Pageén" }] },
    { "name": "spaces trimmed", "input": "[[ Page A | shown ]]", "links": [{ "page": "Page A", "section": null, "text": "shown" }] },
    { "name": "escaped pipe (tables)", "input": "[[Page A\\|shown]]", "links": [{ "page": "Page A", "section": null, "text": "shown" }] },
    { "name": "two links on a line", "input": "[[A]] and [[B|b]]", "links": [{ "page": "A", "section": null, "text": "A" }, { "page": "B", "section": null, "text": "b" }] },
    { "name": "empty is not a link", "input": "[[ ]] and [[|x]] and [[#]]", "links": [] },
    { "name": "no line breaks inside", "input": "[[Page\nA]]", "links": [] },
    { "name": "no brackets inside", "input": "[[a [b] c]]", "links": [] },
    { "name": "inline code is not a link", "input": "Text `[[Page A]]` and ``x [[B]] x`` then [[C]]", "links": [{ "page": "C", "section": null, "text": "C" }] },
    { "name": "fenced code is not a link", "input": "```\n[[Page A]]\n```\n\n~~~~\n[[B]]\n~~~~\n\n[[C]]", "links": [{ "page": "C", "section": null, "text": "C" }] },
    { "name": "escaped bracket", "input": "\\[[Page A]] and [[B]]", "links": [{ "page": "B", "section": null, "text": "B" }] },
    { "name": "inside formatting", "input": "**[[Page A]]** and *[[B|b]]*", "links": [{ "page": "Page A", "section": null, "text": "Page A" }, { "page": "B", "section": null, "text": "b" }] },
    { "name": "in a list and a quote", "input": "- [[A]]\n- two\n\n> [[B]]", "links": [{ "page": "A", "section": null, "text": "A" }, { "page": "B", "section": null, "text": "B" }] },
    { "name": "in a table", "input": "| a | b |\n|---|---|\n| [[A\\|x]] | [[B]] |", "links": [{ "page": "A", "section": null, "text": "x" }, { "page": "B", "section": null, "text": "B" }] },
    { "name": "in a footnote", "input": "Text[^1]\n\n[^1]: See [[A]].", "links": [{ "page": "A", "section": null, "text": "A" }] },
    { "name": "in a heading", "input": "## About [[A|the a]]", "links": [{ "page": "A", "section": null, "text": "the a" }] },
    { "name": "hash in shown text", "input": "[[A|number #1]]", "links": [{ "page": "A", "section": null, "text": "number #1" }] },
    { "name": "unicode title", "input": "[[Ünïcödé 名前]]", "links": [{ "page": "Ünïcödé 名前", "section": null, "text": "Ünïcödé 名前" }] },
    { "name": "images are not page links", "input": "[[File:A.png|right|Cap]] and [[file:B.svg]]", "links": [] },
    { "name": "links in image captions", "input": "[[File:A.png|left|See [[Page B]] and [[C|c]]]]", "links": [{ "page": "Page B", "section": null, "text": "Page B" }, { "page": "C", "section": null, "text": "c" }] }
  ],
  "anchors": [
    { "name": "basic", "input": "## Early Life\n\n### Later years", "anchors": ["early-life", "later-years"] },
    { "name": "repeats numbered", "input": "## Early Life\n\n## Early Life\n\n## early life", "anchors": ["early-life", "early-life-2", "early-life-3"] },
    { "name": "formatting removed", "input": "## **Bold** and *italic* ~~gone~~", "anchors": ["bold-and-italic-gone"] },
    { "name": "links use shown text", "input": "## About [[Page A|the a]] and [web](https://example.com)", "anchors": ["about-the-a-and-web"] },
    { "name": "code text kept", "input": "## The `code` part", "anchors": ["the-code-part"] },
    { "name": "closing hashes", "input": "## Title ##", "anchors": ["title"] },
    { "name": "empty heading", "input": "## ", "anchors": ["section"] },
    { "name": "not a heading", "input": "#nospace\n\n    ## indented code", "anchors": [] },
    { "name": "fenced heading ignored", "input": "```\n## In code\n```\n## Real", "anchors": ["real"] },
    { "name": "punctuation kept", "input": "## What's up?", "anchors": ["what's-up?"] },
    { "name": "notes section", "input": "## Notes\n\nText[^1]\n\n[^1]: A note.", "anchors": ["notes", "notes-2"] },
    { "name": "unicode", "input": "## Ünïcödé Ärä", "anchors": ["ünïcödé-ärä"] }
  ]
}
